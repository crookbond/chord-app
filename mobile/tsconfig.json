{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@chord/kernel": [
        "../kernel/src/index.ts"
      ],
      "@chord/kernel/*": [
        "../kernel/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "../kernel/src/**/*",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

# Copy this to scripts/deploy/deploy.env and fill in. Gitignored.

# GCP
PROJECT_ID=your-gcp-project-id
ZONE=us-central1-a
INSTANCE=chord
MACHINE_TYPE=e2-standard-2
DISK_SIZE=30GB

# Domain + TLS
DOMAIN=chordapp.ai
DOMAIN_ALIASES="www.chordapp.ai"   # space-separated, optional
CERTBOT_EMAIL=you@example.com

# Local path to the production server env file. Start from example.env.
# This file is pushed to the VM verbatim as /srv/chord/.env on every deploy.
SERVER_ENV_FILE=./scripts/deploy/.env.prod

# Parent directory `pull-data` writes its backup into. Sibling
# `data.from-vm-<timestamp>/` dirs land next to whatever you set here.
# Use WSL-style paths from WSL: C:\dev\chord-deps\data → /mnt/c/dev/chord-deps/data
LOCAL_DATA_DIR=/mnt/c/dev/chord-deps/data

# ADR 0091 - MaxMind GeoLite2 license key, for the briefing's weather
# location. Free: sign up at maxmind.com, accept the GeoLite2 EULA, then
# Account -> Manage License Keys. Unset is fine - the deploy skips the
# database and weather falls back to a timezone-derived city, which users
# can correct in Settings.
MAXMIND_LICENSE_KEY=

# Cloud SQL migration (ADR 0202, scripts/deploy/cloudsql.sh). All optional; defaults shown.
# CLOUDSQL_REGION=          # defaults to the region of ZONE
# CLOUDSQL_INSTANCE=chord-db
# CLOUDSQL_TIER=db-custom-1-3840
# CLOUDSQL_STORAGE_GB=20
# CLOUDSQL_KMS_KEYRING=chord-keys
# The database password is NOT set here: export CLOUDSQL_APP_PASSWORD in your shell.

# Secrets in Secret Manager (ADR 0211, docs/ops/secrets.md). Empty = secrets travel in .env as before.
#   fetch = the services also fetch them at start (values still in .env, identical)
#   only  = they are removed from the .env that reaches the VM
# SECRETS_MODE=

# Crash reports (ADR 0227, docs/ops/crash-monitor.md). Empty = off. Set to owner/name and a GitHub
# issue is filed when chord or chord-worker stops abnormally. The token is read on the VM from the
# Secret Manager secret named below; it is never in this file or in .env.prod.
# CRASH_REPORT_REPO=owner/name
# CRASH_REPORT_TOKEN_SECRET=CRASH_REPORT_GITHUB_TOKEN
